# Copy to .env (never commit .env). Without a key, Rally falls back to offline keyword rules.
ANTHROPIC_API_KEY=
# Optional: only for the OpenAI side of scripts/tier_benchmark.py
OPENAI_API_KEY=
# Optional: model used by the live parser test (pytest -m live). Default: claude-haiku-5-5
RALLY_MODEL=claude-haiku-5-5
# Optional: where SQLite files live (default: ./runtime)
# RALLY_RUNTIME_DIR=./runtime
